{
  "name": "drawrail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture:milestone-4": "tsx scripts/capture-milestone-4.ts",
    "capture:final": "tsx scripts/capture-final.ts",
    "validate:mainnet": "tsx scripts/validate-mainnet.ts",
    "validate:pyth": "NODE_OPTIONS='--conditions=react-server' tsx scripts/validate-pyth.ts"
  },
  "dependencies": {
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.3.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "decimal.js": "10.6.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "description": "Policy-preserving liquidity for tokenized-stock portfolios on Solana.",
  "homepage": "https://github.com/Alike001/drawrail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alike001/drawrail.git"
  },
  "type": "module"
}
