# Server-only. Use a production-grade mainnet RPC for validation and deployment.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only Jupiter Developer Platform key.
JUPITER_API_KEY=

# Server-only Pyth Pro credential. Never prefix this with NEXT_PUBLIC_.
PYTH_PRO_API_KEY=

# Deployment availability gate; this is separate from the user's policy choice.
PYTH_POLICY_ENABLED=false
PYTH_MAX_FEED_AGE_MS=5000
PYTH_MAX_CONFIDENCE_BPS=100
PYTH_CLOCK_SKEW_MS=1000

# Fixed Milestone 1 defaults.
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
MULTIPLIER_SAFETY_WINDOW_SECONDS=900

# Public deployment labels and an optional public-key-only development default.
NEXT_PUBLIC_APP_MODE=mainnet-read-only
NEXT_PUBLIC_READ_ONLY_WALLET=
